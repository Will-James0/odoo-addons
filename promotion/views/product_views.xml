<odoo>
    <record id="view_product_promotion_tree" model="ir.ui.view">
        <field name="name">product.promotion.tree</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <tree string="Products with Promotions">
                <field name="name"/>
                <field name="promotion_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="view_product_promotion_form" model="ir.ui.view">
        <field name="name">product.promotion.form</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <form string="Product">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="promotion_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_promotion" model="ir.actions.act_window">
        <field name="name">Products with Promotions</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree,form</field>
    </record>


    <!--<menuitem id="menu_product_promotion" name="Products with Promotions" parent="menu_promotion_root" action="action_product_promotion"/>-->
</odoo>
