<odoo>
    <!-- Inherit Stock Move Form View -->
    <record id="view_stock_move_form_inherit" model="ir.ui.view">
        <field name="name">stock.move.form.inherit.free_units</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_qty']" position="after">
                <field name="free_units" string="UG"/>
            </xpath>
        </field>
    </record>

    <!-- Adjust Stock Move Tree View -->
    <record id="view_stock_move_tree_inherit" model="ir.ui.view">
        <field name="name">stock.move.tree.inherit.free_units</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_qty']" position="after">
                <field name="free_units" string="UG"/>
            </xpath>
        </field>
    </record>
</odoo>
